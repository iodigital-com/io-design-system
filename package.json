{
  "name": "io-design-system",
  "private": true,
  "version": "0.0.1",
  "description": "Root workspace orchestration for io Digital Design System",
  "workspaces": [
    "io-components",
    "io-storefront",
    "io-components-react",
    "io-components-vue",
    "io-components-angular"
  ],
  "scripts": {
    "dev": "npm --workspace @iodigital-com/components run dev",
    "build:components": "npm --workspace @iodigital-com/components run build",
    "build:wrapper:react": "npm --workspace @iodigital-com/components-react run build",
    "build:wrapper:vue": "npm --workspace @iodigital-com/components-vue run build",
    "build:wrapper:angular": "npm --workspace @iodigital-com/components-angular run build && node scripts/verify-angular-build.mjs",
    "build:wrappers": "npm run build:wrapper:react && npm run build:wrapper:vue && npm run build:wrapper:angular",
    "build": "npm run build:components && npm run build:wrappers",
    "test": "npm --workspace @iodigital-com/components run test && npm --workspace @iodigital-com/storefront run test",
    "type-check": "npm --workspace @iodigital-com/storefront run type-check",
    "build:storefront": "npm --workspace @iodigital-com/storefront run build",
    "size": "size-limit",
    "lighthouse:ci": "npm exec --workspace @iodigital-com/storefront -- lhci autorun --config=.lighthouserc.json",
    "lint": "eslint io-components/src io-storefront/src --ext .ts,.tsx",
    "lint:fix": "eslint io-components/src io-storefront/src --ext .ts,.tsx --fix",
    "commitlint": "commitlint --edit",
    "sync:stencil-assets": "node scripts/sync-stencil-assets.cjs",
    "sync:stencil-assets:check": "node scripts/sync-stencil-assets.cjs --check",
    "token-naming:check": "node scripts/check-token-cssvar-naming.cjs",
    "token-runtime:check": "node scripts/check-token-runtime-reconciliation.cjs",
    "token-doc-coverage:check": "node scripts/check-token-doc-coverage.cjs",
    "style-literals:check": "node scripts/check-style-literals.cjs",
    "status-governance:check": "node scripts/check-storefront-status-governance.cjs",
    "dark-mode-tokens:check": "node scripts/check-dark-mode-tokens.cjs",
    "check:public-css-api": "node scripts/check-public-css-api.cjs",
    "changeset:check": "node scripts/check-changeset-bump-levels.mjs",
    "governance:check": "node scripts/agency-validate-governance.cjs && node scripts/check-token-cssvar-naming.cjs && node scripts/check-token-runtime-reconciliation.cjs && node scripts/check-token-doc-coverage.cjs && node scripts/check-style-literals.cjs && node scripts/check-storefront-status-governance.cjs && node scripts/check-dark-mode-tokens.cjs && node scripts/check-public-css-api.cjs && node scripts/check-changeset-bump-levels.mjs",
    "api:snapshot": "node scripts/snapshot-api-surface.cjs",
    "api:check": "node scripts/check-api-surface.cjs",
    "security:audit": "npm audit --audit-level=high",
    "type-coverage": "npm --workspace @iodigital-com/components run type-coverage",
    "events:guard": "node scripts/check-no-io-prefixed-events.cjs",
    "agents:install:claude": "node scripts/install-curated-agency-claude.cjs",
    "agents:sync:copilot": "node scripts/sync-curated-agency-copilot.cjs",
    "agents:sync:copilot-extended": "node scripts/sync-curated-agency-copilot-extended.cjs",
    "agents:check:copilot-drift": "node scripts/check-copilot-agent-drift.cjs",
    "agents:check:copilot-extended-drift": "node scripts/check-copilot-agent-extended-drift.cjs",
    "build:storefront:release": "npm run build:components && npm run sync:stencil-assets && npm run build:storefront",
    "build:quality-gates": "npm run governance:check && npm run events:guard && npm run check:public-css-api && npm run lint && npm run build && npm run api:check && npm run sync:stencil-assets:check && npm run size && npm run test && npm run type-coverage && npm run type-check && npm run build:storefront && npm run lighthouse:ci && npm run security:audit",
    "prepare": "simple-git-hooks",
    "tokens:scrape": "node scripts/scrape-tokens.mjs",
    "tokens:scrape:resume": "node scripts/scrape-tokens.mjs --resume",
    "tokens:merge": "node scripts/merge-tokens.mjs",
    "tokens:html": "node scripts/generate-html.mjs",
    "tokens:sync": "npm run tokens:scrape && npm run tokens:merge && npm run tokens:html",
    "changeset:add": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version && npm install --package-lock-only"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.1.0",
    "@stencil/vitest": "^1.11.6",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.58.2",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.1.0",
    "typescript-eslint": "^8.59.1"
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit $1"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
