// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`io-toast — render snapshots > renders active toast item state 1`] = `
<io-toast role="status" aria-live="polite" aria-atomic="true" data-position="bottom-end" position="bottom-end" class="hydrated">
  <mock:shadow-root>
    <div role="alert" aria-live="assertive" aria-atomic="true" class="toast__assertive-region"></div>
    <io-toast-item variant="success" class="hydrated">
      <mock:shadow-root shadowrootdelegatesfocus>
        <div class="toast">
          <span class="toast__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.801 10A10 10 0 1 1 17 3.335"></path>
              <path d="m9 11 3 3L22 4"></path>
            </svg>
          </span>
          <span class="toast__text">
            Settings saved.
          </span>
          <button type="button" class="toast__close" aria-label="Dismiss notification">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </mock:shadow-root>
    </io-toast-item>
  </mock:shadow-root>
</io-toast>
`;

exports[`io-toast — render snapshots > renders default state 1`] = `
